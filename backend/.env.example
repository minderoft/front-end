# ============================================
# LocaPlus - Configuration d'exemple
# ============================================
# IMPORTANT: Copiez ce fichier vers .env et remplissez vos valeurs r�elles
# NE JAMAIS commit ce fichier avec de vraies valeurs!

# Serveur
PORT=5000
NODE_ENV=production

# Base de données MySQL
# Render doit utiliser uniquement DATABASE_URL.
DATABASE_URL=mysql://your_db_user:your_db_password@your_railway_host:3306/your_db_name

# JWT - Générez une clé secrète aléatoire forte
# Utilisez: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Frontend URL (pour CORS) en production
FRONTEND_URL=https://front-end-hazel-chi.vercel.app
PAYSTACK_CALLBACK_URL=https://your-frontend-domain.com/payment-success

# ============================================
# PAYSTACK - Configuration des paiements
# Obtenez vos cl�s sur https://dashboard.paystack.com/#/settings/api
# Production: sk_live_xxx / pk_live_xxx
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# PayStack prend en charge:
# - Wave, Orange Money, MTN Mobile Money, Moov Money
# - Cartes bancaires (Visa, Mastercard)
