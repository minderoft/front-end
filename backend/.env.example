# ============================================
# LocaPlus - Configuration d'exemple
# ============================================
# IMPORTANT: Copiez ce fichier vers .env et remplissez vos valeurs réelles
# NE JAMAIS commit ce fichier avec de vraies valeurs!

# Serveur
PORT=5000
NODE_ENV=development

# Base de données MySQL Railway
# Si vous utilisez Railway MySQL, configurez DATABASE_URL comme ceci :
# DATABASE_URL=mysql://username:password@hostname:port/dbname
# Pour les environnements locaux, ou si Railway n'expose pas DATABASE_URL, vous pouvez aussi fournir :
# DB_HOST=your_mysql_host
# DB_PORT=3306
# DB_NAME=railway
# DB_USER=root
# DB_PASSWORD=your_database_password

DATABASE_URL=mysql://your_username:your_password@your_host:3306/your_database

# JWT - Générez une clé secrète aléatoire forte
# Utilisez: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost:5173

# URL de redirection après paiement (facultatif)
# Si vous souhaitez que PayStack redirige vers une page de confirmation côté frontend
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment-success

# ============================================
# PAYSTACK - Configuration des paiements
# ============================================
# Obtenez vos clés sur https://dashboard.paystack.com/#/settings/api
# Test: sk_test_xxx / pk_test_xxx
# Production: sk_live_xxx / pk_live_xxx
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# PayStack prend en charge:
# - Wave, Orange Money, MTN Mobile Money, Moov Money
# - Cartes bancaires (Visa, Mastercard)