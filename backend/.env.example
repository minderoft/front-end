# ============================================
# LocaPlus - Configuration d'exemple
# ============================================
# IMPORTANT: Copiez ce fichier vers .env et remplissez vos valeurs réelles
# NE JAMAIS commit ce fichier avec de vraies valeurs!

# Serveur
PORT=5000
NODE_ENV=development

# Base de données MySQL (Railway)
# Obtenez ces valeurs depuis votre dashboard Railway
DB_HOST=your_mysql_host.proxy.rlwy.net
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your_database_password

# JWT - Générez une clé secrète aléatoire forte
# Utilisez: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost:5173

# ============================================
# PAYSTACK - Configuration des paiements
# ============================================
# Obtenez vos clés sur https://dashboard.paystack.com/#/settings/api
# Test: sk_test_xxx / pk_test_xxx
# Production: sk_live_xxx / pk_live_xxx
PAYSTACK_SECRET_KEY=test_33cc5e16d33b34cd323433378b8ca7b16168cb4b
PAYSTACK_PUBLIC_KEY=pk_test_bbee9b48fb0d2223e4d8dd05359a319fc8f0bb23

# PayStack prend en charge:
# - Wave, Orange Money, MTN Mobile Money, Moov Money
# - Cartes bancaires (Visa, Mastercard)