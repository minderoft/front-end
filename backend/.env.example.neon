# ============================================
# CONFIGURATION BACKEND - NEON.TECH PostgreSQL
# ============================================

# 📱 PORT
PORT=10000

# 🗄️ DATABASE - PostgreSQL (Neon.tech)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-icy-truth-aluxmjbr.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require

# 🎫 JWT TOKEN
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# 💳 PAYSTACK CONFIGURATION
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_CALLBACK_URL=https://backend-ovbc.onrender.com/api/payment/callback

# 🌐 FRONTEND URL (pour CORS et redirections)
FRONTEND_URL=https://loca-plus-hub.vercel.app

# 📧 EMAIL CONFIGURATION (optionnel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SENDER_EMAIL=noreply@locaplus.com

# 🔔 NOTIFICATIONS (optionnel)
ENABLE_NOTIFICATIONS=true

# ============================================
# NOTES:
# 1. Remplace YOUR_PASSWORD_HERE par le mot de passe de ta BD Neon
# 2. Neon demande sslmode=require (automatiquement géré)
# 3. Ne commite JAMAIS ce fichier sur GitHub
# 4. Utilise un .env.local en développement
# ============================================
